{
  "name": "fx_drive",
  "version": "0.1.0",
  "description": "Glanceable currency and crypto dashboard for BMW iDrive",
  "private": false,
  "main": "javascript/runner.js",
  "mguInternet": true,
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 20,
    "memoryThresholdKB": 65536,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "FXDR",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "fonts",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md",
    "LICENSES.txt"
  ],
  "dependencies": { "oap-sdk": "24.10.2" },
  "engines": { "node": ">=8.7.0" },
  "author": "custom",
  "license": "MIT",
  "mguLocalOnly": true,
  "mguHmi": ["ID7", "ID8"]
}
