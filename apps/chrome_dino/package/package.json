{
  "name": "chrome_dino",
  "version": "1.4.8",
  "description": "Пиксельная игра Chrome Dino для BMW iDrive 7/8. Четыре уровня сложности, кактусы и птицы, анимация бега, рекорды, русский и английский языки. Прыжок нажатием контроллера iDrive. Только на стоящем автомобиле.",
  "main": "javascript/app.js",
  "private": false,
  "author": "arudmin",
  "license": "MIT",
  "engines": {
    "node": ">=8.7.0"
  },
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "mguLocalOnly": true,
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "CDG1",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  }
}
