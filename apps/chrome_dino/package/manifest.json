{
  "proxies": {
    "de.bmw.infotainment.hmi.entrypoint.EntryPoint": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPointManager": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmi": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmiApplication": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceBundle": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.StringBundle": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseInstance": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseProvider": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseRegistry": {
      "attributes": {
        "useCaseIds": "r"
      },
      "broadcasts": [
        "registryUpdate"
      ],
      "instances": "*",
      "methods": [
        "getProvider"
      ]
    },
    "de.bmw.infotainment.lifecycle.lifecycle.Lifecycle": {
      "attributes": {
        "powerStateDetailed": "rs"
      },
      "instances": "Front"
    },
    "de.bmw.infotainment.personalization.SessionManager": "*",
    "de.bmw.infotainment.telematic.oap.AppBookmarks": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerBookmark"
      ]
    },
    "de.bmw.infotainment.telematic.oap.PrivateEntryPoint": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerEntryPoint",
        "unregisterEntryPoint",
        "setSelected",
        "setAvailability"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WakeUpOnDemand": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerParticipant",
        "unregisterParticipant"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WodControl": {
      "instances": "${userId}",
      "methods": [
        "offerService",
        "stopOfferingService"
      ]
    },
    "de.bmw.infotainment.telematic.oapcontroller.OAPController": "*",
    "de.bmw.infotainment.hmi.entrypoint2.EntryPoint2": "*",
    "de.bmw.infotainment.hmi.entrypoint2.EntryPointManager2": "*",
    "de.bmw.infotainment.hmi.remote2.RemoteHmi2": "*",
    "de.bmw.infotainment.hmi.remote2.RemoteHmiApplication2": "*",
    "de.bmw.infotainment.hmi.resourcemanagement2.ResourceManager2": "*",
    "de.bmw.infotainment.hmi.resourcemanagement2.ResourceBundle2": "*",
    "de.bmw.infotainment.hmi.resourcemanagement2.StringBundle2": "*",
    "de.bmw.infotainment.hmi.usecasemanagement.UseCaseContext": "*",
    "de.bmw.infotainment.telematic.oap.PrivateEntryPoint2": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "genericMethod"
      ]
    },
    "org.genivi.nodestatemanager.Consumer": {
      "broadcasts": [
        "ShutdownEvents",
        "SessionStateChanged"
      ],
      "instances": "NSMConsumer",
      "methods": [
        "LifecycleRequestComplete",
        "RegisterShutdownClient",
        "UnRegisterShutdownClient"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "instances": "1",
      "attributes": {
        "statusCarSpeed2": "rs"
      }
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "instances": "1",
      "attributes": {
        "statusRotaryEncoderState": "rs"
      }
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "instances": [
        "HMI_CID"
      ],
      "attributes": {
        "currentDisplayLanguage": "rs"
      }
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "instances": "SystemFunctionsInternalTasuInst1",
      "methods": [
        "sendTasuRequest"
      ],
      "broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "services": {
    "de.bmw.infotainment.telematic.oap.AppStatus": {
      "instances": [
        "${userId}"
      ]
    },
    "de.bmw.infotainment.telematic.oap.TriggersControl": {
      "instances": [
        "${userId}"
      ]
    }
  }
}
