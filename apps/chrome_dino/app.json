{
  "id": "chrome_dino",
  "title": "Chrome Dino Game",
  "description": "Offline dinosaur runner for stationary BMW MGU. Press central iDrive controller to jump. BACK returns to menu.",
  "version": "1.4.4",
  "vendor": "arudmin",
  "loggingId": "CDG1",
  "maxDiskUsage": 10485760,
  "iconGlyph": "play",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": [
        "HMI_CID"
      ],
      "currentDisplayLanguage": "rs",
      "_optional": "Menu language falls back to English when HMIContext is unavailable"
    },
    "de.bmw.infotainment.hmi.hmicontext2.HMIContext2": {
      "_instances": [
        "1"
      ],
      "currentDisplayLanguage": "rs",
      "_optional": "Menu language falls back to English when HMIContext is unavailable"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Chrome Dino Game",
      "items": [
        [
          "button",
          "BTN_PLAY",
          "Play / Continue"
        ],
        [
          "button",
          "BTN_DIFFICULTY",
          "Difficulty: NORMAL"
        ],
        [
          "button",
          "BTN_LANGUAGE",
          "Language: Auto (BMW)"
        ],
        [
          "text",
          "MENU_INFO",
          ""
        ],
        [
          "text",
          "MENU_HELP",
          "Choose difficulty here. Press controller to jump. BACK: menu. Parked only."
        ]
      ]
    },
    {
      "name": "GAME",
      "kind": "canvas",
      "title": "Chrome Dino Game",
      "chrome": false,
      "buttons": [
        [
          "BTN_JUMP",
          "Jump / Start"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "best",
      "label": "Best score",
      "type": "number",
      "default": 0,
      "hidden": true
    },
    {
      "key": "difficulty",
      "label": "Difficulty (0 Easy, 1 Normal, 2 Hard, 3 Extreme)",
      "type": "number",
      "default": 1,
      "hidden": true
    },
    {
      "key": "language",
      "label": "Language (auto or code)",
      "type": "string",
      "default": "auto",
      "hidden": true
    }
  ]
}
