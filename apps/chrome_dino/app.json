{
  "id": "chrome_dino",
  "title": "Chrome Dino Game",
  "description": "Pixel dinosaur runner for BMW iDrive 7/8. Four difficulty modes, animated dinosaur, high scores, automatic BMW language detection and multilingual menus. Parked only.",
  "version": "1.4.11",
  "vendor": "arudmin",
  "loggingId": "CDG1",
  "maxDiskUsage": 10485760,
  "iconGlyph": "play",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": [
        "HMI_CID"
      ],
      "currentDisplayLanguage": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Chrome Dino Game",
      "items": [
        [
          "button",
          "BTN_PLAY",
          "Play / Continue"
        ],
        [
          "button",
          "BTN_DIFFICULTY",
          "Difficulty: NORMAL"
        ],
        [
          "button",
          "BTN_LANGUAGE",
          "Language: Auto"
        ],
        [
          "text",
          "MENU_INFO",
          ""
        ],
        [
          "text",
          "MENU_BEST",
          ""
        ],
        [
          "text",
          "MENU_BMW",
          "BMW language: detecting..."
        ],
        [
          "text",
          "MENU_HELP",
          "Press Play, then controller to jump. BACK: menu. Parked only."
        ]
      ]
    },
    {
      "name": "GAME",
      "kind": "canvas",
      "title": "Chrome Dino Game",
      "chrome": false,
      "buttons": [
        [
          "BTN_JUMP",
          "Jump / Start"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "best",
      "label": "Best score",
      "type": "number",
      "default": 0,
      "hidden": true
    },
    {
      "key": "difficulty",
      "label": "Difficulty (0 Easy, 1 Normal, 2 Hard, 3 Extreme)",
      "type": "number",
      "default": 1,
      "hidden": true
    },
    {
      "key": "language",
      "label": "Language",
      "type": "choice",
      "default": "auto",
      "hidden": true,
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "ru",
          "Русский"
        ],
        [
          "en",
          "English"
        ]
      ]
    }
  ]
}
