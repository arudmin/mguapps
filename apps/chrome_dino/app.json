{
  "id": "chrome_dino",
  "title": "Chrome Dino Game",
  "description": "Pixel dinosaur runner for BMW iDrive 7/8. Four difficulty modes, animated dinosaur, high scores, automatic BMW language detection and multilingual menus. Parked only.",
  "version": "1.4.12",
  "vendor": "arudmin",
  "loggingId": "CDG1",
  "maxDiskUsage": 10485760,
  "iconGlyph": "play",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "requires": {
    "idrive7-renderd": "2.1.18",
    "mgu-inputgate": "1.1.0"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": [
        "HMI_CID"
      ],
      "currentDisplayLanguage": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
